APP_NAME="Bait El Kebash"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=sqlite
# Replace with an absolute path to a NEW disposable local database.
DB_DATABASE=D:/githubProj/Bait-El-Kebash/database/api-local.sqlite
DB_URL=
DB_FOREIGN_KEYS=true
SESSION_DRIVER=database
SESSION_COOKIE=bait-el-kebash-session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=array
API_MAIL_ENABLED=false
# PHONE_SENDER defaults to App\Services\Phone\UnavailablePhoneSender.
API_LOGIN_PER_MINUTE=5
API_REGISTER_PER_MINUTE=5
API_PHONE_REQUESTS_PER_TEN_MINUTES=3
API_PHONE_VERIFICATIONS_PER_MINUTE=10

